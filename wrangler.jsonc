{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lobster-ledger-local",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/mcp", "/oauth/*", "/.well-known/*"],
  },
  "vars": {
    "GROUP_NAME": "The Lobster Ledger",
    "APP_ORIGIN": "http://localhost:8787",
    "GOOGLE_CLIENT_ID": "",
    "OWNER_EMAIL": "",
  },
  "secrets": { "required": ["GOOGLE_CLIENT_SECRET"] },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lobster-ledger",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
