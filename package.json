{
  "name": "lobster-ledger",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "build": "pnpm check && vite build && pnpm build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "test:cli-install": "node scripts/test-cli-install.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b && tsc --noEmit -p cli/tsconfig.json",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "node scripts/production-config.mjs && pnpm build && wrangler deploy --dry-run --config wrangler.production.json && wrangler d1 migrations apply DB --remote --config wrangler.production.json && wrangler deploy --config wrangler.production.json",
    "format": "prettier --write src worker migrations docs index.html package.json tsconfig.json vite.config.ts vitest.config.ts wrangler.jsonc README.md"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "leaflet": "1.9.4",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@napi-rs/keyring": "2.1.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.1",
    "jsdom": "30.1.0",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20260911.0-alpha",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
